{
    "private": true,
    "name": "runrun",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "postinstall": "bun run build",
        "build": "vite build",
        "deploy": "bun run build && devvit upload",
        "dev": "concurrently -k -p \"[{name}]\" -n \"BUILD,DEVVIT\" -c \"blue,magenta\" \"vite build --watch\" \"dotenv -e .env -- devvit playtest\"",
        "dev:devvit": "dotenv -e .env -- devvit playtest",
        "login": "devvit login",
        "launch": "bun run build && bun run deploy && devvit publish",
        "type-check": "tsc --build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@devvit/web": "0.13.0",
        "@hono/node-server": "^2.0.5",
        "devvit": "0.13.0",
        "hono": "^4.12.22",
        "kaplay": "^3001.0.19"
    },
    "devDependencies": {
        "@devvit/start": "0.13.0",
        "@devvit/test": "0.13.0",
        "concurrently": "^9.2.1",
        "dotenv-cli": "^11.0.0",
        "typescript": "6.0.3",
        "vite": "8.0.14",
        "vitest": "^4.1.7"
    },
    "packageManager": "bun@1.3.13"
}